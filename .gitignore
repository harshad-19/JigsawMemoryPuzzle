# ============================================================
# .gitignore — JigsawMemoryPuzzle
# Java / Maven / Jakarta Servlet web application
# ============================================================

# ── Maven build output ──────────────────────────────────────
target/

# ── WAR file at the project root (generated artifact) ───────
*.war

# ── JVM crash dumps ─────────────────────────────────────────
hs_err_pid*.log
replay_pid*.log

# ── Database credentials — NEVER commit the real file ───────
# The working file lives at src/main/resources/db.properties.
# A placeholder template db.properties.example IS committed.
# The real db.properties must stay local only.
src/main/resources/db.properties

# ── IDE — IntelliJ IDEA ─────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── IDE — Eclipse / Spring Tool Suite ───────────────────────
.classpath
.project
.settings/
bin/

# ── IDE — VS Code (keep settings.json if the team uses it) ──
# .vscode/               ← intentionally NOT ignored;
#                          java.configuration.updateBuildConfiguration
#                          is useful for teammates with VS Code Java.

# ── IDE — NetBeans ──────────────────────────────────────────
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ──────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs ─────────────────────────────────────────────────────
*.log

# ── Local environment overrides ──────────────────────────────
.env
.env.local

# ── Secrets and key files ────────────────────────────────────
*.pem
*.key
*.p12
*.jks
